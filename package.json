{
  "name": "endorl",
  "productName": "EndORL",
  "version": "1.10.0",
  "description": "Documentação clínica em vídeo e fotografia",
  "main": "main.js",
  "author": "EndORL",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "pt.endorl.app",
    "productName": "EndORL",
    "files": ["index.html", "main.js", "preload.js", "xion-buttons.js", "voice.js", "strobe.js", "fees.js", "templates.js", "signoff.js", "package.json", "logo.png", "build/icon.png"],
    "directories": { "output": "dist" },
    "win": { "signAndEditExecutable": false, "icon": "build/icon.png" },
    "portable": { "artifactName": "EndORL-${version}-portatil.exe" },
    "nsis": {
      "artifactName": "EndORL-${version}-instalador.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "EndORL"
    }
  }
}
