{
  "name": "ditado-video",
  "productName": "Ditado Video",
  "version": "1.1.0",
  "description": "Documentação clínica em vídeo e fotografia",
  "main": "main.js",
  "author": "Ditado",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "pt.ditado.video",
    "productName": "Ditado Video",
    "files": ["index.html", "main.js", "preload.js", "package.json"],
    "directories": { "output": "dist" },
    "win": { "signAndEditExecutable": false },
    "portable": { "artifactName": "DitadoVideo-${version}-portatil.exe" },
    "nsis": {
      "artifactName": "DitadoVideo-${version}-instalador.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Ditado Video"
    }
  }
}
